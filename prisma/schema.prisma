generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?  @default("")
  price       Float
  stock       Int      @default(0)
  imageUrl    String?   @default("https://placehold.co/300x300?text=Producto")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cartItems   CartItem[] 
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?  // opcional para no romper los usuarios ya existentes
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")
}

// Representa el carrito activo
model Cart {
  id        String     @id @default(uuid())
  userId    String
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

// Cada línea del carrito: cuántas unidades y qué producto
model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id]) 

  @@map("cart_items")
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  total           Float
  street          String
  city            String
  postalCode      String
  country         String
  
  createdAt       DateTime    @default(now()) @map("created_at")
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  quantity        Int
  priceAtPurchase Float
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
}